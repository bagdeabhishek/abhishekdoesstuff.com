---
import SiteLayout from "./SiteLayout.astro";
import ResearchNotice from "../components/ResearchNotice.astro";
import { displayExcerpt } from "../lib/musings";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  schema: unknown;
  headings?: Heading[];
}

const {
  title,
  description,
  canonicalPath,
  schema,
  headings = [],
} = Astro.props;
const sections = headings.filter(({ depth }) => depth === 2);
---

<SiteLayout
  title={`${title} — Abhishek Does Stuff`}
  socialTitle={title}
  description={description}
  canonicalPath={canonicalPath}
  bodyClass="workbench subpage musing-article"
  ogType="article"
  schema={schema}
>
  <main id="main-content" class="article-shell musing-shell">
    <p class="page-breadcrumb">
      <a href="/">The workbench</a><span>/</span><a href="/musings/">All Musings</a>
    </p>
    <header class="article-header">
      <p class="section-kicker">From the research notebook</p>
      <h1>{title}</h1>
      <p class="article-deck">{displayExcerpt(description)}</p>
    </header>
    <div class:list={["reading-layout", { "reading-single": !sections.length }]}>
      <article class="reading-copy">
        <ResearchNotice title={title} />
        <div class="prose"><slot /></div>
      </article>
      {
        sections.length > 0 && (
          <details class="article-contents" data-contents open>
            <summary>
              In this note <span aria-hidden="true">+</span>
            </summary>
            <nav aria-label="Article contents">
              {sections.map((heading) => (
                <a href={`#${heading.slug}`}>{heading.text}</a>
              ))}
            </nav>
          </details>
        )
      }
    </div>
  </main>
</SiteLayout>
