---
import SiteLayout from "../../layouts/SiteLayout.astro";
import birdsStyles from "../../styles/birds.css?url";

---

<SiteLayout
  title="The Listening Orrery — Birds Heard in Bengaluru"
  description="A live acoustic orrery: recurring birds heard from a Bengaluru home, arranged by microphone rarity and illustrated with historical natural-history plates."
  canonicalPath="/birds/"
  bodyClass="workbench subpage birds-page"
  styles={[birdsStyles]}
  socialTitle="The Listening Orrery"
  socialDescription="A live Bengaluru soundscape arranged as an orrery of historical bird plates. Familiar voices circle close; rare voices travel further—and get more paper."
>
<main id="main-content" class="birds-main">
      <p class="page-breadcrumb">
        <a href="/">The workbench</a><span>/</span><span>Listening Orrery</span>
      </p>
      <section class="orrery-section" aria-labelledby="bird-title">
        <header class="orrery-intro">
          <div>
            <p class="eyebrow">
              <span>live acoustic instrument</span
              ><span>Bengaluru · 12.97° N</span>
            </p>
            <h1 id="bird-title">The listening<br /><em>orrery.</em></h1>
          </div>
          <div class="orrery-prologue">
            <p>
              A microphone listens from home. Naturalists from three centuries
              supply the pictures. Familiar voices circle close; rare voices
              travel further—and get more paper.
            </p>
            <small
              >This is rarity to this microphone, not ecological rarity or
              conservation status.</small
            >
          </div>
        </header>

        <div class="instrument-readout" role="group" aria-label="Live listening status">
          <div class="readout-live">
            <span class="stream-indicator"
              ><i aria-hidden="true"></i
              ><b id="stream-label">connecting</b></span
            >
            <span>BirdNET · archive open</span>
          </div>
          <dl class="bird-metrics">
            <div>
              <dt>in orbit</dt>
              <dd id="species-count">—</dd>
            </div>
            <div>
              <dt>registrations</dt>
              <dd id="detection-count">—</dd>
            </div>
            <div>
              <dt>last heard</dt>
              <dd id="last-heard">—</dd>
            </div>
            <div>
              <dt>one-offs withheld</dt>
              <dd id="filtered-count">—</dd>
            </div>
          </dl>
          <p id="latest-detection" class="latest-detection" aria-live="polite">
            Waiting for the next call…
          </p>
        </div>

        <div
          id="bird-state"
          class="bird-state"
          role="status"
          aria-live="polite"
        >
          <span class="state-spinner" aria-hidden="true"></span>
          Calibrating the instrument…
        </div>

        <p class="plate-invitation">
          Open a plate to inspect the bird’s record, original artwork, and
          source.
        </p>

        <div class="orrery-shell" aria-describedby="orrery-caption">
          <svg class="orrery-rings" viewBox="0 0 1000 1000" aria-hidden="true">
            <circle class="orbit orbit-rare" cx="500" cy="500" r="420"></circle>
            <circle
              class="orbit orbit-occasional"
              cx="500"
              cy="500"
              r="280"
            ></circle>
            <circle
              class="orbit orbit-familiar"
              cx="500"
              cy="500"
              r="155"
            ></circle>
            <circle class="orbit-core" cx="500" cy="500" r="92"></circle>
            <line
              id="detection-ray"
              class="detection-ray"
              x1="500"
              y1="500"
              x2="500"
              y2="500"
            ></line>
          </svg>

          <span class="orbit-label label-rare" aria-hidden="true"
            >outer orbit · 2–5 heard</span
          >
          <span class="orbit-label label-occasional" aria-hidden="true"
            >middle orbit · 6–50</span
          >
          <span class="orbit-label label-familiar" aria-hidden="true"
            >daily chorus · 51+</span
          >

          <div class="orrery-core" aria-hidden="true">
            <span class="core-signal"><i></i><i></i><i></i></span>
            <small>listening point</small>
            <strong id="core-bird">awaiting a call</strong>
            <span id="core-time">live from home</span>
          </div>

          <div
            id="bird-wall"
            class="bird-orrery"
            role="group"
            aria-label="Recurring bird species arranged by microphone rarity"
            aria-busy="true"
          ></div>
        </div>

        <div id="orrery-caption" class="orrery-key">
          <p>
            <b>Radius</b
            ><span
              >Common voices stay near the microphone. Seldom-heard voices
              travel outward.</span
            >
          </p>
          <p>
            <b>Plate size</b
            ><span
              >Inverse logarithmic frequency: fewer registrations give a bird
              more paper.</span
            >
          </p>
          <p>
            <b>Fresh ink</b
            ><span
              >A live call draws a ray from the listening point to its
              historical plate.</span
            >
          </p>
        </div>

        <aside class="hearing-ledger" aria-labelledby="ledger-title">
          <div>
            <p class="section-kicker">wet ink</p>
            <h2 id="ledger-title">Fresh registrations</h2>
          </div>
          <ol id="recent-hearings">
            <li class="ledger-empty">
              The next live detection will be registered here.
            </li>
          </ol>
        </aside>
      </section>

      <section class="instrument-notes" aria-labelledby="method-title">
        <header>
          <p class="section-kicker">instrument notes</p>
          <h2 id="method-title">
            Natural history, rearranged by an electronic ear.
          </h2>
        </header>
        <div class="reading-notes">
          <article>
            <span>Ⅰ</span>
            <h3>Calls become records</h3>
            <p>
              BirdNET identifies calls at the microphone and sends new
              detections into the instrument as they happen.
            </p>
          </article>
          <article>
            <span>Ⅱ</span>
            <h3>Doubt stays outside</h3>
            <p>
              A species enters an orbit only after its second detection. Single
              occurrences remain visible only as a withheld count.
            </p>
          </article>
          <article>
            <span>Ⅲ</span>
            <h3>Old plates meet new data</h3>
            <p>
              Scientific names join the live archive to openly licensed
              natural-history art, with source and credit intact.
            </p>
          </article>
        </div>
        <p class="archive-note">
          The plates come from open collections including Wikimedia Commons, the
          Biodiversity Heritage Library, Naturalis, and the National Gallery of
          Art. One modern open illustration stands in for the Ashy Prinia: its
          1798–1805 British Library watercolor is catalogued, but not digitized.
        </p>
      </section>
    </main>

    <dialog id="bird-dialog" class="bird-dialog" aria-labelledby="dialog-name">
      <button
        class="dialog-close"
        type="button"
        aria-label="Close bird details"
      >
        ×
      </button>
      <div class="dialog-grid">
        <figure>
          <img id="dialog-image" alt="" />
        </figure>
        <div class="dialog-copy">
          <p class="dialog-kicker">open folio</p>
          <h2 id="dialog-name"></h2>
          <p id="dialog-scientific" class="dialog-scientific"></p>
          <dl class="dialog-stats">
            <div>
              <dt>heard</dt>
              <dd id="dialog-count"></dd>
            </div>
            <div>
              <dt>first</dt>
              <dd id="dialog-first"></dd>
            </div>
            <div>
              <dt>latest</dt>
              <dd id="dialog-last"></dd>
            </div>
            <div>
              <dt>confidence</dt>
              <dd id="dialog-confidence"></dd>
            </div>
          </dl>
          <div class="art-credit">
            <span>artwork</span>
            <strong id="dialog-art"></strong>
            <p id="dialog-collection"></p>
            <p id="dialog-note"></p>
            <a id="dialog-source" href="" target="_blank" rel="noreferrer"
              >View source and licence ↗</a
            >
          </div>
        </div>
      </div>
    </dialog>

  <Fragment slot="scripts">
    <script is:inline src="/birds.js?v=20260923-1" defer></script>
  </Fragment>
</SiteLayout>
