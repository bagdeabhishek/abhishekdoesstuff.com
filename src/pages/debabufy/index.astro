---
import SiteLayout from "../../layouts/SiteLayout.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": "https://abhishekdoesstuff.com/debabufy/#app",
  "name": "DeBabufy",
  "url": "https://abhishekdoesstuff.com/debabufy/",
  "description": "A local-first desktop app for deterministic, reviewable automation of repetitive Indian government workflows.",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Windows, macOS, Linux",
  "softwareVersion": "0.2.9",
  "downloadUrl": "https://github.com/bagdeabhishek/debabufy/releases/latest",
  "codeRepository": "https://github.com/bagdeabhishek/debabufy",
  "license": "https://opensource.org/license/mit",
  "author": {
    "@type": "Person",
    "@id": "https://abhishekdoesstuff.com/#abhishek-bagade",
    "name": "Abhishek Bagade"
  }
};
---

<SiteLayout
  title="DeBabufy — Less babu. More done."
  description="DeBabufy is a local-first desktop app that automates repetitive Indian government-portal workflows while keeping login, review, submission, and payment under your control."
  canonicalPath="/debabufy/"
  bodyClass="workbench subpage debabufy-page"
  schema={schema}
  socialTitle="DeBabufy — Your paperwork. Less babu. More done."
  socialDescription="A local-first desktop app for deterministic, reviewable automation of repetitive Indian government workflows."
  socialImage="https://abhishekdoesstuff.com/assets/projects/debabufy-mark.png"
  socialImageAlt="DeBabufy logo: a document breaking free from red tape into a teal check mark"
  socialImageWidth="1254"
  socialImageHeight="1254"
  twitterCard="summary"
  twitterTitle="DeBabufy — Less babu. More done."
  twitterDescription="Local-first desktop automation for repetitive Indian government workflows."
  twitterImage="https://abhishekdoesstuff.com/assets/projects/debabufy-mark.png"
  twitterImageAlt="DeBabufy logo: a document breaking free from red tape into a teal check mark"
>
<main id="main-content" class="debabufy-shell">
      <p class="page-breadcrumb">
        <a href="/">The workbench</a><span>/</span><span>DeBabufy</span>
      </p>
      <section class="debabufy-hero" aria-labelledby="debabufy-title">
        <div class="debabufy-hero-copy">
          <div class="debabufy-hero-label">
            <img
              class="debabufy-hero-icon"
              src="/assets/projects/debabufy-mark.png"
              alt=""
              width="1254"
              height="1254"
              fetchpriority="high"
            />
            <div>
              <p class="debabufy-wordmark">DeBabufy</p>
              <p class="eyebrow">
                <span>open source</span><span>local first</span
                ><span>India made</span>
              </p>
            </div>
          </div>
          <h1 id="debabufy-title">
            Your paperwork.<br /><em>Less babu.</em><br />More done.
          </h1>
          <p class="debabufy-lede">
            India runs on forms. DeBabufy handles the repetitive bits with
            deterministic desktop automations you can watch, review, and stop.
          </p>
          <div class="actions">
            <a
              class="button primary"
              href="https://github.com/bagdeabhishek/debabufy/releases/latest"
              >Download DeBabufy</a
            >
            <a class="button" href="https://github.com/bagdeabhishek/debabufy"
              >View source on GitHub</a
            >
          </div>
          <p class="release-note">
            Alpha · Windows, macOS &amp; Linux · MIT licensed
          </p>
        </div>
        <div class="paperwork-drawing" aria-hidden="true">
          <div class="paperwork-caption">A little less paperwork.</div>
          <div class="paperwork-sheet paperwork-previous">
            <span class="paperwork-sheet-label">Previous statement</span>
            <div class="paperwork-lines"></div>
            <div class="paperwork-lines short"></div>
            <div class="paperwork-lines"></div>
            <div class="paperwork-lines short"></div>
            <span class="paperwork-red-tape"></span>
          </div>
          <div class="paperwork-sheet paperwork-current">
            <span class="paperwork-sheet-label">This instalment</span
            ><span class="paperwork-form-title"
              >Carry forward.<br />Check. Continue.</span
            >
            <div class="paperwork-row"><span>Party details</span><b>✓</b></div>
            <div class="paperwork-row">
              <span>Property details</span><b>✓</b>
            </div>
            <div class="paperwork-row"><span>New values</span><b>✓</b></div>
            <div class="paperwork-review">
              Your review comes next <span>↗</span>
            </div>
          </div>
          <span class="paperwork-pencil"></span
          ><span class="paperwork-footnote"
            >The final step is always yours.</span
          >
        </div>
      </section>

      <nav class="debabufy-index" aria-label="On this page">
        <span>Inside this project</span
        ><a href="#how-title">How it works <span>01</span></a
        ><a href="#workflow-title">First workflow <span>02</span></a
        ><a href="#trust-title">The ground rules <span>03</span></a
        ><a href="#cta-title">Get involved <span>04</span></a>
      </nav>

      <section class="debabufy-strip" aria-label="DeBabufy principles">
        <div><strong>01</strong><span>Runs on your machine</span></div>
        <div><strong>02</strong><span>No runtime LLM</span></div>
        <div><strong>03</strong><span>You approve the final step</span></div>
      </section>

      <section class="debabufy-section" aria-labelledby="how-title">
        <div class="section-heading">
          <div>
            <p class="section-kicker">01 / how it works / no magic tricks</p>
            <h2 id="how-title">
              Bring the old paperwork.<br /><em>Change what changed.</em>
            </h2>
          </div>
          <p>
            DeBabufy carries forward the stable facts, calculates the new values
            with explicit rules, and fills the portal in an ordinary Chrome
            session.
          </p>
        </div>
        <ol class="debabufy-flow">
          <li>
            <span>01</span><strong>Add the previous document</strong>
            <p>Your source stays local on your computer.</p>
          </li>
          <li>
            <span>02</span><strong>Enter this time’s amount</strong>
            <p>Review every inferred party, date, and tax value.</p>
          </li>
          <li>
            <span>03</span><strong>Log in normally</strong>
            <p>You handle credentials, OTP, and CAPTCHA yourself.</p>
          </li>
          <li>
            <span>04</span><strong>Watch it fill the portal</strong>
            <p>DeBabufy stops before submission or payment.</p>
          </li>
        </ol>
      </section>

      <section
        class="debabufy-section debut-workflow"
        aria-labelledby="workflow-title"
      >
        <div class="workflow-copy">
          <p class="section-kicker">02 / workflow 001 / available now</p>
          <h2 id="workflow-title">Form 141.<br />Schedule B.</h2>
          <p>
            Property-TDS instalments with joint buyers and corporate or
            non-corporate sellers. The workflow reads the previous statement,
            carries forward property and party details, calculates whole-rupee
            portal values, then fills each portal section in sequence.
          </p>
          <a
            class="text-link"
            href="https://github.com/bagdeabhishek/debabufy#available-today"
            >See exactly what it automates →</a
          >
        </div>
        <div
          class="workflow-terminal"
          aria-label="Example DeBabufy workflow status"
        >
          <div class="terminal-bar">
            <b>debabufy / form-141</b
            ><span class="workflow-example-label">Example run</span>
          </div>
          <p><i>✓</i> previous statement read</p>
          <p><i>✓</i> parties &amp; property inferred</p>
          <p><i>✓</i> whole-rupee values calculated</p>
          <p><i>✓</i> buyer and seller details added</p>
          <p><i>✓</i> transaction filled</p>
          <p class="terminal-hold"><i>●</i> waiting for your review</p>
        </div>
      </section>

      <section
        class="debabufy-section trust-section"
        aria-labelledby="trust-title"
      >
        <p class="section-kicker">03 / the ground rules</p>
        <h2 id="trust-title">Boring <em>by design.</em></h2>
        <div class="trust-grid">
          <article>
            <strong>Local by default</strong>
            <p>No filing backend, telemetry, or document upload service.</p>
          </article>
          <article>
            <strong>Deterministic</strong>
            <p>
              No model improvising with PANs, dates, amounts, or portal actions.
            </p>
          </article>
          <article>
            <strong>Human controlled</strong>
            <p>Login, OTP, review, submission, and payment stay with you.</p>
          </article>
          <article>
            <strong>Open to inspection</strong>
            <p>
              The code, workflow rules, issues, and releases are public on
              GitHub.
            </p>
          </article>
        </div>
      </section>

      <section class="debabufy-cta" aria-labelledby="cta-title">
        <div>
          <p class="section-kicker">04 / built in the open</p>
          <h2 id="cta-title">One boring workflow at a time.</h2>
          <p>
            Try the first workflow, report a portal change, or help build the
            next bit of Indian paperwork out of existence.
          </p>
        </div>
        <div class="actions">
          <a
            class="button primary"
            href="https://github.com/bagdeabhishek/debabufy/releases/latest"
            >Get the latest release</a
          >
          <a
            class="button"
            href="https://github.com/bagdeabhishek/debabufy/blob/main/CONTRIBUTING.md"
            >Contribute on GitHub</a
          >
        </div>
      </section>

      <p class="debabufy-disclaimer">
        DeBabufy is unofficial alpha software. It is not affiliated with or
        endorsed by the Government of India or the Income Tax Department, and it
        does not provide tax or legal advice. Always review the portal before
        continuing.
      </p>
    </main>
</SiteLayout>
