---
import { render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import {
  SITE_ORIGIN,
  articleSchema,
  getPublishedMusingEntries,
  slugFromMusingRoute,
  summarizeMusing,
  type MusingEntry,
} from "../../lib/musings";

export async function getStaticPaths() {
  const entries = await getPublishedMusingEntries();
  return entries.map((entry) => ({
    params: {
      slug: slugFromMusingRoute(
        entry.data.permalink || `/musings/${entry.id}/`,
      ),
    },
    props: { entry },
  }));
}

interface Props {
  entry: MusingEntry;
}

const { entry } = Astro.props;
const redirectTo = entry.data.redirect_to;
const summary = redirectTo ? undefined : summarizeMusing(entry);
const rendered = redirectTo ? undefined : await render(entry);
const Content = rendered?.Content;
let sectionNumber = 0;
const headings = (rendered?.headings ?? []).map((heading) =>
  heading.depth === 2
    ? { ...heading, slug: `musing-section-${++sectionNumber}` }
    : heading,
);
const redirectCanonical = redirectTo
  ? new URL(redirectTo, SITE_ORIGIN).href
  : undefined;
---

{
  redirectTo ? (
    <>
      <Fragment set:html="<!doctype html>" />
      <html lang="en-IN">
        <head>
          <meta charset="utf-8" />
          <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />
          <meta name="robots" content="noindex" />
          <link rel="canonical" href={redirectCanonical} />
          <title>Moved — Abhishek Does Stuff</title>
        </head>
        <body>
          <p>This note moved to <a href={redirectTo}>{redirectTo}</a>.</p>
        </body>
      </html>
    </>
  ) : (
    summary &&
    Content && (
      <ArticleLayout
        title={summary.title}
        description={summary.description}
        canonicalPath={summary.route}
        schema={articleSchema(summary)}
        headings={headings}
      >
        <Content />
      </ArticleLayout>
    )
  )
}
