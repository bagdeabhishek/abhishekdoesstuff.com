---
interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
const sectionHref = (section: string) => home ? `#${section}` : `/#${section}`;
---

<footer class="workshop-footer">
  {home && (
    <section class="maker-note" id="about" aria-labelledby="maker-note-title">
      <figure class="maker-portrait">
        <img
          src="/assets/brand/portrait.webp?v=20261018-6"
          alt="Pen-and-ink portrait of Abhishek, drawn from a beach photograph"
          width="800"
          height="1200"
          loading="lazy"
          decoding="async"
        />
        <figcaption>Abhishek Bagade · Bengaluru</figcaption>
      </figure>
      <div class="maker-note-copy">
        <p class="workshop-kicker">A note from the workbench</p>
        <h2 id="maker-note-title">Hi, I’m Abhishek.</h2>
        <p>
          Engineer by day, maker whenever I get the chance. This is where I keep the
          things I build, fix, and figure out after work. Some turn into useful
          projects. Others leave me with a good story.
        </p>
      </div>
    </section>
  )}
  <div class="footer-main">
    <div>
      <p class="workshop-kicker">Something on your workbench?</p>
      <a class="footer-hello" href="mailto:admin@abhishekdoesstuff.com">
        Let’s compare notes<span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="footer-links">
      <a rel="me" href="https://github.com/bagdeabhishek">GitHub ↗</a>
      <a rel="me" href="https://www.instagram.com/abhishek_does_stuff/">Instagram ↗</a>
      <a rel="me" href="https://www.linkedin.com/in/bagdeabhishek/">LinkedIn ↗</a>
      <a href="https://abagade.com/">Writing ↗</a>
    </div>
  </div>
  <nav class="footer-directory" aria-label="Footer navigation">
    <a href={sectionHref("builds")}>Builds</a>
    <a href={sectionHref("field-notes")}>Field notes</a>
    <a href="/musings/">Musings</a>
    <a href="/birds/">Birds</a>
    <a href={sectionHref("lab")}>Lab</a>
    <a href="mailto:admin@abhishekdoesstuff.com">Email ↗</a>
  </nav>
  <div class="footer-colophon">
    <span>© Abhishek Bagade</span>
    <span>An ongoing collection. Served from home.</span>
    <a href={home ? "#top" : "#page-top"}>Back to the top ↑</a>
  </div>
</footer>
